#############################################
# DejaVista (.env.example)
# Copy to `.env` and fill in real values
#############################################

########## Frontend (Vite – extension) ##########

# Supabase (browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional override for the deployed API URL (defaults to production)
VITE_VERCEL_API_URL=https://dejavistaa.vercel.app


########## Backend (Vercel / local serverless) ##########

# Supabase (server)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Gemini / Google AI (API‑key path)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional Vertex AI (service‑account path)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
VERTEX_AI_LOCATION=us-central1


########## Optional: real virtual try‑on provider ##########

# e.g. Nanobanana / any try‑on API
TRYON_API_URL=https://your-tryon-provider.com/v1/tryon
TRYON_API_KEY=your-secret-tryon-api-key